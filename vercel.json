{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/sync-frontend-data.js && pnpm --filter @nanommo/shared build && node scripts/set-env.js && pnpm --filter @nanommo/frontend build --configuration production",
  "outputDirectory": "apps/frontend/dist/frontend/browser",
  "installCommand": "pnpm install --frozen-lockfile",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:file(chunk-.*|main-.*|polyfills-.*|styles-.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(character|npcs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
