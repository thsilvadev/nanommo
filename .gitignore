# TypeScript emit that landed next to the sources. The api/shared tsconfigs
# build to dist/; these were stale committed copies of an older emit and were
# shadowing the real .ts files for anyone reading the tree.
apps/api/src/**/*.d.ts
apps/api/src/**/*.d.ts.map
apps/api/src/**/*.js.map
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.d.ts.map
packages/shared/src/**/*.js.map
packages/shared/src/**/*.js
.env
.env.local
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
.turbo/
pnpm-lock.yaml
project/
# Keep the two map waypoint overlays shipped by the frontend; the root project/ art source remains ignored.
!apps/frontend/public/project/
!apps/frontend/public/project/destination_pinpoint.png
!apps/frontend/public/project/T_waypoint.png
