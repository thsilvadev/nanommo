NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=nanommo
DB_PASSWORD=nanommo_dev_password
DB_NAME=nanommo
DB_LOGGING=false
RUN_MIGRATIONS=true

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=dev_secret_key_change_in_production
JWT_EXPIRY=7d

# CPF Hashing
CPF_PEPPER=dev_pepper_change_in_production

# CORS
CORS_ORIGIN=*

# Features
PROFANITY_FILTER=true
CHAT_RATE_LIMIT_MS=1000
ENCOUNTER_BASE_SEARCH_TIME_S=4
MAP_CAPACITY=50
