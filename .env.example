NODE_ENV=development
PORT=3000

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=nanommo
DB_PASSWORD=nanommo_dev_password
DB_NAME=nanommo
DB_LOGGING=false

# Postgres init (used by docker-compose db service)
POSTGRES_USER=nanommo
POSTGRES_PASSWORD=nanommo_dev_password
POSTGRES_DB=nanommo

# JWT
JWT_SECRET=super_secret_key_change_in_production_12345
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS
CORS_ORIGIN=*

# Frontend
FRONTEND_URL=http://localhost:4200

# API URL (used by frontend build on Vercel)
API_URL=https://api.botpit.online

# SMTP (used for email verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Throttler (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=5
RESEND_VERIFICATION_COOLDOWN_MS=60000