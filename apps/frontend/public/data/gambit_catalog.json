{
  "meta": {
    "pagesPerCharacter": 3,
    "maxGambitsPerPage": 20,
    "maxConditionsPerLine": 1,
    "onlyOneActivePageAtATime": true,
    "pageSwitchAllowedOnlyOutOfBattle": true,
    "executionRule": "Each tick, evaluate lines top to bottom. The first line whose condition(s) evaluate true AND whose action can currently be legally executed (skill known+equipped+off cooldown, item in stock, enough SP, etc.) performs its action and ends the tick. If a line's condition is true but its action cannot be legally executed, that line is skipped (NOT counted as 'first true'), and evaluation continues to the next line.",
    "botFallbackPage": "If the active page produces no legal action on a tick (all conditions false or all matching actions illegal), the character does nothing that tick (idles) and simply re-evaluates on the next tick.",
    "uiRule": "Any gambit line referencing a skill not unlocked/equipped, or an item with 0 stock, must render greyed-out in the editor with a tooltip explaining why it cannot fire."
  },
